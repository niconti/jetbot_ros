<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jetbot_ros</name>
  <version>0.0.0</version>
  <description>ROS nodes for JetBot</description>
  <maintainer email="dustinf@nvidia.com">Dustin Franklin</maintainer>
  <license>MIT</license>

  <depend>python3-scipy</depend>
  <depend>python3-smbus</depend>

  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>image_pipeline</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>wireless_watcher</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
